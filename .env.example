# Next.js server route
CADENCIA_ENABLE_LIVE=false
CADENCIA_INTENT_SERVICE_URL=http://127.0.0.1:8080
CADENCIA_SERVICE_TOKEN=

# Python intent service: GPT-6 Luna in production (every OpenAI setting is required)
CADENCIA_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-6-luna
OPENAI_TOKEN_PARAM=max_completion_tokens
OPENAI_TEMPERATURE=0.2
OPENAI_REASONING_EFFORT=none
# DeepSeek, kept only as a fallback: CADENCIA_PROVIDER=deepseek with
# DEEPSEEK_API_KEY= and DEEPSEEK_MODEL=deepseek-flash
