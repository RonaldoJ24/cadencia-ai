{
  "name": "cadencia-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:live": "node --env-file-if-exists=service/.env.local scripts/dev-live.mjs",
    "build": "node scripts/build-guard.mjs build && node scripts/check-dist.mjs",
    "deploy": "bash scripts/deploy.sh --prod",
    "deploy:check": "bash scripts/deploy.sh --dry-run",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types --include-runtime=false --strict-vars=false"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module"
}
