{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadencia-ai",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadencia_beta",
      "database_id": "1e26d779-9aaf-4785-96c7-ab55d8e8032a",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "adaptation-workflow",
      "binding": "ADAPTATION_WORKFLOW",
      "class_name": "AdaptationWorkflow"
    }
  ],
  "vars": {
    "CADENCIA_ENABLE_LIVE": "true",
    "CADENCIA_INTENT_SERVICE_URL": "https://cadencia-intents-675488596560.us-central1.run.app",
    "CADENCIA_ALLOW_TEST_IDENTITY": "false",
    "CADENCIA_DAILY_LIVE_QUOTA": "10",
    "CADENCIA_PUBLIC_DAILY_QUOTA": "5",
    "CADENCIA_PUBLIC_GLOBAL_DAILY_CAP": "50",
    "CADENCIA_PUBLIC_VISITOR_CONCURRENCY": "1",
    "CADENCIA_PUBLIC_GLOBAL_CONCURRENCY": "10",
    "CADENCIA_PUBLIC_MINUTE_LIMIT": "2",
    "CADENCIA_ACCESS_TEAM_DOMAIN": "",
    "CADENCIA_ACCESS_AUD": ""
  },
  "secrets": {
    "required": [
      "CADENCIA_SERVICE_TOKEN"
    ]
  }
}
