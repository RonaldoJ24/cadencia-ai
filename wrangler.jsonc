{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadencia-ai",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadencia_beta",
      "database_id": "1e26d779-9aaf-4785-96c7-ab55d8e8032a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CADENCIA_ENABLE_LIVE": "true",
    "CADENCIA_INTENT_SERVICE_URL": "https://cadencia-intents-675488596560.us-central1.run.app"
  },
  "secrets": {
    "required": [
      "CADENCIA_SERVICE_TOKEN"
    ]
  }
}
