# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example

# links to the posts evaluation cases were adapted from (evals/cases/SOURCING.md)
evals/cases/*.private.jsonl
*.tsbuildinfo

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Python runtime, test caches, and local evaluation reports
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
*.py[cod]

# Evaluation dry runs are never evidence (evals/dry-runs/README.md).
evals/dry-runs/*
!evals/dry-runs/README.md
